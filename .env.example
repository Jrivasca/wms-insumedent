# ---- Application ----
APP_NAME=WMS Defontana
ENVIRONMENT=development
API_PORT=8000

# ---- MongoDB ----
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=wms

# ---- Auth / Security ----
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
# Optional dedicated key for credential encryption (Fernet-compatible 32-byte url-safe base64).
# If empty, a key is derived deterministically from JWT_SECRET.
ENCRYPTION_KEY=
# Token required to call the protected seed endpoint.
SEED_TOKEN=seed-me

# ---- Defontana integration ----
# When true, the Defontana connector returns simulated data (no network calls).
DEFONTANA_MOCK=true
DEFONTANA_ENV=test
DEFONTANA_TEST_BASE_URL=https://replapi.defontana.com/api
DEFONTANA_PROD_BASE_URL=https://api.defontana.com/api
# Días hacia atrás para traer pedidos en despacho desde Defontana.
DEFONTANA_ORDERS_WINDOW_DAYS=90
# Sincronización automática de pedidos (worker), en hora local de DEFONTANA_TIMEZONE.
DEFONTANA_ORDERS_SYNC_ENABLED=false
DEFONTANA_ORDERS_SYNC_INTERVAL_MINUTES=15
DEFONTANA_ORDERS_SYNC_HOURS=08:00-19:00
DEFONTANA_ORDERS_SYNC_WEEKDAYS_ONLY=true
DEFONTANA_TIMEZONE=America/Santiago
# Recepción → Inventory/Insert. Valores probados en pruebas, PENDIENTES de confirmar con
# Defontana (tipo de documento PE/MOV001/XAJ_ENT_UN, motivo y centro de negocio).
DEFONTANA_RECEPTION_SYNC_ENABLED=false
DEFONTANA_RECEPTION_DOCUMENT_TYPE=MOV001
DEFONTANA_RECEPTION_REASON_ID=COMPRA
DEFONTANA_BUSINESS_CENTER=EMPNEGVTAVTA000
DEFONTANA_RECEPTION_CENTRALIZABLE=false

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Web Push (VAPID) — Fase 2 (opcional; vacío = push off) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notificaciones@selarix.cl

# ---- Ingesta por carpeta (folder-watch) — Plan 1 (opcional; false = off) ----
INTAKE_ENABLED=false
INTAKE_INBOUND_DIR=/data/inbound
INTAKE_TENANT_ID=
INTAKE_INTERVAL_SECONDS=120
INTAKE_PRODUCTS_ENABLED=false
