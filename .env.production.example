# ---- Production environment ----
# Copy to .env on the droplet. deploy/deploy.sh fills the secrets automatically
# if you leave the placeholders below untouched.

APP_NAME=WMS Defontana
ENVIRONMENT=production
API_PORT=8000

# ---- MongoDB (internal to the compose network) ----
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=wms

# ---- Auth / Security ----
# Leave as placeholders to let deploy.sh generate strong values automatically.
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
ENCRYPTION_KEY=
SEED_TOKEN=seed-me

# ---- Inventory ----
ALLOW_NEGATIVE_STOCK=false

# ---- Defontana integration ----
# Keep true until you load real credentials from the "Configuración Defontana" UI.
DEFONTANA_MOCK=true

# Push de altas hacia el ERP (crear producto / pedido / documento de entrada).
# false = operación stand-alone: el WMS opera solo y no encola sincronizaciones.
# Ponlo en true cuando Defontana esté conectado de verdad.
ERP_SYNC_ENABLED=false
DEFONTANA_ENV=test
DEFONTANA_TEST_BASE_URL=https://replapi.defontana.com/api
DEFONTANA_PROD_BASE_URL=https://api.defontana.com/api

# ---- Reverse proxy / TLS ----
# ":80"  -> HTTP only, reachable by the droplet IP (default).
# domain -> e.g. SITE_ADDRESS=wms.midominio.cl enables automatic HTTPS.
SITE_ADDRESS=:80

# Puertos del HOST que publica el WMS. Por defecto 80/443.
# Si el droplet YA tiene un reverse proxy / otra app en 80/443, pon puertos libres
# (p. ej. 8080 y 8443), WMS_BIND_HOST=127.0.0.1 y deja SITE_ADDRESS=:80; luego tu
# proxy enruta hacia 127.0.0.1:8080.
WMS_HTTP_PORT=80
WMS_HTTPS_PORT=443
# Interfaz de bind: 0.0.0.0 = accesible por la IP pública; 127.0.0.1 = solo local
# (recomendado detrás de un reverse proxy existente).
WMS_BIND_HOST=0.0.0.0

# Subred Docker del stack. Solo hace falta tocarla si el pool por defecto de Docker
# está agotado en el droplet ("all predefined address pools have been fully
# subnetted") o si 10.125.0.0/24 colisiona con otra red de tu host.
WMS_SUBNET=10.125.0.0/24

# ---- CORS ----
# La SPA se sirve mismo-origen a través del proxy, así que CORS no se ejercita en el
# navegador. Si llamas la API desde otro origen, lista los orígenes separados por
# coma, p. ej.  CORS_ORIGINS=https://wms.midominio.cl,https://otra.cl
CORS_ORIGINS=

# ---- Web Push (VAPID) — notificaciones push Fase 2 (opcional) ----
# Vacío = push deshabilitado (el feed in-app sigue funcionando). Generar el par de
# claves una vez, p. ej. dentro del contenedor backend:
#   docker exec wms_backend python -c "from cryptography.hazmat.primitives.asymmetric import ec; \
#     from cryptography.hazmat.primitives import serialization as s; import base64; \
#     k=ec.generate_private_key(ec.SECP256R1()); \
#     pem=k.private_bytes(s.Encoding.PEM,s.PrivateFormat.PKCS8,s.NoEncryption()); \
#     pub=k.public_key().public_bytes(s.Encoding.X962,s.PublicFormat.UncompressedPoint); \
#     print('VAPID_PUBLIC_KEY='+base64.urlsafe_b64encode(pub).rstrip(b'=').decode()); \
#     print('VAPID_PRIVATE_KEY='+base64.b64encode(pem).decode())"
# VAPID_PUBLIC_KEY es la application server key (base64url) que usa el navegador.
# VAPID_PRIVATE_KEY es el PEM de la clave EC P-256 codificado en base64 (una línea).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notificaciones@selarix.cl

# ---- Ingesta por carpeta (folder-watch) — Plan 1 Fase 1/2 (opcional) ----
# El worker lee PDFs de pedidos de INTAKE_INBOUND_DIR/pedidos y Excel de productos de
# INTAKE_INBOUND_DIR/productos cada INTAKE_INTERVAL_SECONDS. La carpeta se sincroniza
# desde la nube con rclone (p. ej. rclone mount o `rclone sync` por cron) hacia el host
# ./inbound, montado en el worker como /data/inbound. Vacío/false = deshabilitado
# (el import manual por la UI sigue igual).
INTAKE_ENABLED=false
INTAKE_INBOUND_DIR=/data/inbound
# Tenant dueño de los archivos. Si se deja vacío y existe un único tenant, se usa ese.
INTAKE_TENANT_ID=
INTAKE_INTERVAL_SECONDS=120
# Folder-watch de PRODUCTOS (Excel). Por defecto false: el catálogo se importa solo
# de forma MANUAL (botón "Importar Excel"). El folder-watch de pedidos es aparte.
INTAKE_PRODUCTS_ENABLED=false
